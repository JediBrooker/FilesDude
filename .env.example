# FilesDude only serves files inside this directory.
FILEDUDE_ROOT=/data
FILEDUDE_STATE_DIR=/state

# The login name shown in the web UI.
FILEDUDE_USERNAME=admin

# Generate this with: FILEDUDE_PASSWORD='a-long-password' npm run password
# Keep the hash single-quoted so Compose treats every $ literally.
FILEDUDE_PASSWORD_HASH=

# Generate this with: openssl rand -base64 48
FILEDUDE_SESSION_SECRET=

FILEDUDE_SESSION_HOURS=12
FILEDUDE_MAX_UPLOAD_MB=512
FILEDUDE_TRASH_ENABLED=true
# Set false to turn off public share links entirely (existing links stop working).
FILEDUDE_SHARING_ENABLED=true

# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
FILEDUDE_TRUST_PROXY=true

# Docker Compose only reads these three (see the README's "Install with Docker"): the folder
# FilesDude manages, and the user and group it works as.
FILEDUDE_HOST_ROOT=/srv/files
PUID=1000
PGID=1000
